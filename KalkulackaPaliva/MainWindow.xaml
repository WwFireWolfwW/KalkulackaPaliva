<Window x:Class="KalkulackaPaliva.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DRIVE / Kalkulačka paliva" Width="1120" Height="800" MinWidth="860" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#0B1017" Foreground="#F1F5F9"
 FontFamily="Segoe UI" UseLayoutRounding="True" Language="cs-CZ">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Tlumeny" TargetType="TextBlock"><Setter Property="Foreground" Value="#9BAABD"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Popisek" TargetType="TextBlock"><Setter Property="Foreground" Value="#D8E1EC"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
  <Style x:Key="Vstup" TargetType="TextBox">
   <Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="CaretBrush" Value="#81F5CD"/>
   <Setter Property="SelectionBrush" Value="#347B68"/><Setter Property="Background" Value="#0E1621"/>
   <Setter Property="BorderBrush" Value="#2C394B"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,12"/><Setter Property="FontSize" Value="21"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Ramecek" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="#9BAABD" FontSize="12" Margin="4,0,15,0" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ramecek" Property="BorderBrush" Value="#6E839D"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Ramecek" Property="BorderBrush" Value="#81F5CD"/><Setter TargetName="Ramecek" Property="Background" Value="#132620"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#81F5CD"/><Setter Property="Foreground" Value="#09231B"/>
   <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Height" Value="54"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="RamecekTlacitka" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RamecekTlacitka" Property="Background" Value="#ACFFE1"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="RamecekTlacitka" Property="Background" Value="#53CDA5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RamecekTlacitka" Property="BorderBrush" Value="White"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="36,28" MaxWidth="1240">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <StackPanel Orientation="Horizontal">
     <Border Background="#81F5CD" CornerRadius="9" Width="36" Height="36" Margin="0,0,12,0">
      <Path Data="M 10,26 L 16,9 L 21,9 L 27,26 M 15,20 L 23,20" Stroke="#0B211A" StrokeThickness="2.5"/>
     </Border>
     <TextBlock Text="DRIVE" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
     <TextBlock Text=" /  plánovač nákladů" Foreground="#9BAABD" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" BorderBrush="#314136" BorderThickness="1" Padding="12,6">
     <TextBlock Text="●  KALKULAČKA PALIVA" FontSize="10" Foreground="#81F5CD" FontWeight="SemiBold"/>
    </Border>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,32,0,26">
    <TextBlock Text="Každá cesta začíná plánem." FontSize="34" FontWeight="Bold"/>
    <TextBlock Text="Zjisti, kam dojedeš a kolik tě bude cesta stát." Style="{StaticResource Tlumeny}" Margin="0,8,0,0" FontSize="15"/>
   </StackPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#141D29" BorderBrush="#263244" BorderThickness="1" CornerRadius="18" Padding="26">
     <StackPanel>
      <TextBlock Text="01  /  PARAMETRY CESTY" Foreground="#81F5CD" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Tvoje auto. Tvoje trasa." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,24"/>
      <TextBlock Text="Objem nádrže" Style="{StaticResource Popisek}"/><TextBox x:Name="NadrzBox" Text="50" Tag="l" Style="{StaticResource Vstup}" Margin="0,0,0,18" TextChanged="Vstup_Zmenen" AutomationProperties.Name="Objem nádrže (l)"/>
<TextBlock Text="Průměrná spotřeba" Style="{StaticResource Popisek}"/><TextBox x:Name="SpotrebaBox" Text="6,5" Tag="l / 100 km" Style="{StaticResource Vstup}" Margin="0,0,0,18" TextChanged="Vstup_Zmenen" AutomationProperties.Name="Průměrná spotřeba (l / 100 km)"/>
<TextBlock Text="Délka plánované cesty" Style="{StaticResource Popisek}"/><TextBox x:Name="TrasaBox" Text="350" Tag="km" Style="{StaticResource Vstup}" Margin="0,0,0,18" TextChanged="Vstup_Zmenen" AutomationProperties.Name="Délka plánované cesty (km)"/>
<TextBlock Text="Cena za litr paliva" Style="{StaticResource Popisek}"/><TextBox x:Name="CenaBox" Text="38,50" Tag="Kč / l" Style="{StaticResource Vstup}" Margin="0,0,0,18" TextChanged="Vstup_Zmenen" AutomationProperties.Name="Cena za litr paliva (Kč / l)"/>
      <Button Content="Spočítat cestu   →" Click="Spocitat_Click" IsDefault="True" Margin="0,4,0,0"/>
      <TextBlock Text="Použít můžeš desetinnou čárku i tečku. Potvrď Enterem." Style="{StaticResource Tlumeny}" FontSize="11" Margin="0,12,0,0"/>
      <Border Background="#351D25" CornerRadius="8" Padding="12" Margin="0,16,0,0">
       <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ChybaText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock x:Name="ChybaText" Text="" Foreground="#FFB4BE" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
      </Border>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Background="#121F20" BorderBrush="#29433D" BorderThickness="1" CornerRadius="18" Padding="26">
     <StackPanel>
      <TextBlock Text="02  /  PŘEHLED CESTY" Foreground="#81F5CD" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Rozpočet pod kontrolou." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,24"/>
      <Border CornerRadius="14" Padding="22" Margin="0,0,0,20">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#234B40" Offset="0"/><GradientStop Color="#16322B" Offset="1"/></LinearGradientBrush></Border.Background>
       <StackPanel>
        <TextBlock Text="CELKOVÁ CENA CESTY" Foreground="#B4D9CA" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock x:Name="CenaText" Text="— Kč" Foreground="#9CFFDA" FontSize="36" FontWeight="Bold" Margin="0,10,0,10" TextWrapping="Wrap"/>
        <TextBlock Text="Odhad nákladů na palivo pro zadanou trasu" Foreground="#B4D9CA" FontSize="12"/>
       </StackPanel>
      </Border>
      <TextBlock Text="Maximální dojezd" Style="{StaticResource Tlumeny}"/>
      <TextBlock x:Name="DojezdText" Text="— km" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,5"/>
      <TextBlock Text="S plnou nádrží při zadané průměrné spotřebě" Style="{StaticResource Tlumeny}" FontSize="11"/>
      <Border Height="1" Background="#2B403E" Margin="0,22"/>
      <TextBlock Text="Palivo potřebné na cestu" Style="{StaticResource Tlumeny}"/>
      <TextBlock x:Name="PalivoText" Text="— l" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,5"/>
      <TextBlock Text="Celková spotřeba pro plánovanou vzdálenost" Style="{StaticResource Tlumeny}" FontSize="11"/>
      <Border Background="#192D2A" CornerRadius="9" Padding="14" Margin="0,26,0,0">
       <TextBlock Text="Výsledky zobrazíš tlačítkem Spočítat cestu. Skutečnou spotřebu ovlivňuje styl jízdy, provoz i terén." Foreground="#AEC4BD" FontSize="12"/>
      </Border>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="0,22,0,0">
    <TextBlock Text="DRIVE  /  Méně odhadů. Více přehledu." Foreground="#8293A8" FontSize="11"/>
    <TextBlock Text="Spotřeba · Dojezd · Náklady" Foreground="#8293A8" FontSize="11" HorizontalAlignment="Right"/>
   </Grid>
  </Grid>
 </ScrollViewer>
</Window>
